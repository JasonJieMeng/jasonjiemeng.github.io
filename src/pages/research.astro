---
import SiteLayout from "../layouts/SiteLayout.astro";

const sections = [
  {
    title: "Publications",
    entries: [
      {
        label: "TMLR",
        title:
          "PERRY: Policy Evaluation with Confidence Intervals using Auxiliary Data",
        year: "2026",
        authors: [
          "Aishwarya Mandyam*",
          "Jason Meng*",
          "Ge Gao",
          "Jiankai Sun",
          "Mac Schwager",
          "Barbara Engelhardt",
          "Emma Brunskill",
        ],
        venue: "Transactions on Machine Learning Research",
        note: "",
        links: [
          {
            label: "Paper",
            url: "https://arxiv.org/abs/2507.20068",
          },
        ],
      },
      {
        label: "IEEE TIT",
        title:
          "Efficient Reinforcement Learning with Impaired Observability: Learning to Act with Delayed and Missing State Observations",
        year: "2024",
        authors: [
          "Minshuo Chen",
          "Jie Meng",
          "Yu Bai",
          "Yinyu Ye",
          "H. Vincent Poor",
          "Mengdi Wang",
        ],
        venue: "IEEE Transactions on Information Theory",
        note: "",
        links: [
          {
            label: "Journal",
            url: "https://ieeexplore.ieee.org/document/10560059",
          },
          {
            label: "Preprint",
            url: "https://arxiv.org/abs/2306.01243",
          },
        ],
      },
    ],
  },
  {
    title: "Manuscripts under review",
    entries: [
      {
        label: "",
        title:
          "Trustmix: Reward Learning from Aggregate Feedback with Heterogeneous Surrogates",
        year: "2026",
        authors: ["Haozhan Gao*", "Jason Meng*"],
        venue: "Submitted to ICLR 2027",
        note: "",
        links: [],
      },
      {
        label: "",
        title:
          "Learning Optimal Distributionally Robust Stochastic Control in Continuous State Spaces",
        year: "2025",
        authors: [
          "Shengbo Wang",
          "Jason Meng",
          "Nian Si",
          "Jose Blanchet",
          "Zhengyuan Zhou",
        ],
        venue: "Submitted to Management Science",
        note: "",
        links: [
          {
            label: "Preprint",
            url: "https://arxiv.org/abs/2406.11281",
          },
        ],
      },
      {
        label: "",
        title:
          "Optimal Policy Learning in Nonstationary Markov Decision Processes with Change Detection",
        year: "2024",
        authors: [
          "Liyan Xie",
          "Jie Meng",
          "Minshuo Chen",
          "H. Vincent Poor",
          "Mengdi Wang",
        ],
        venue: "Submitted to IEEE Transactions on Information Theory",
        note: "",
        links: [],
      },
    ],
  },
  {
    title: "Conference abstracts & presentations",
    entries: [
      {
        label: "AHA",
        title:
          "Beyond Nursing Workload: Developing an Acuity Score for the Cardiovascular Intensive Care Unit at the Stanford Children’s Hospital",
        year: "2026",
        authors: [
          "Jason Meng*",
          "Johnathan Le*",
          "Kaitlyn Kim*",
          "Hannah Thomas*",
          "Aman Dhillon*",
          "Brian Rigby*",
          "Andrew Shin",
          "David Scheinker",
          "Meghna Patel",
          "Rebecca Kameny",
        ],
        venue: "American Heart Association Scientific Sessions 2026",
        note: "",
        //   "Selected for a Top Research oral presentation at the Pediatric Cardiac Intensive Care Society Annual Meeting 2026.",
        links: [],
      },
    ],
  },
];

const isMyName = (author: string) =>
  ["Jason Meng", "Jie Meng"].includes(author.replace(/\*$/, ""));
---

<SiteLayout title="Research">
  <div class="research-page">
    <h1>Research</h1>

    <p class="research-intro">
  My research centers on three questions: 
  <br />
  (1) How can we make reinforcement learning reliable and safe in high-stakes domains?
  <br />
  (2) How can we develop and use simulators to improve decision making?
  <br />
  (3) How can we integrate human expertise into data-driven decision making?
</p>

    <p class="name-note">
      Published as Jason Meng and Jie Meng.
    </p>

    <p class="name-note">
      * Equal contribution.
    </p>

    {
      sections.map((section, sectionIndex) => (
        <section aria-labelledby={`research-section-${sectionIndex}`}>
          <h2 id={`research-section-${sectionIndex}`}>
            {section.title}
          </h2>

          <ul class="publication-list">
            {section.entries.map((entry) => (
              <li class="publication">
                <div class="publication-label">
                  {entry.label ? (
                    <>
                      <span>{entry.label}</span>
                      <span>’{entry.year.slice(-2)}</span>
                    </>
                  ) : (
                    <span>{entry.year}</span>
                  )}
                </div>

                <article>
                  <h3>
                    {entry.links.length > 0 ? (
                      <a
                        href={entry.links[0].url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {entry.title}
                      </a>
                    ) : (
                      entry.title
                    )}
                  </h3>

                  <p class="authors">
                    {entry.authors.map((author, index) => (
                      <span>
                        {index > 0 && ", "}
                        {isMyName(author) ? (
                          <strong>{author}</strong>
                        ) : (
                          author
                        )}
                      </span>
                    ))}
                  </p>

                  {/* <p class="venue">{entry.venue}</p> */}

                  {entry.note && (
                    <p class="publication-note">{entry.note}</p>
                  )}

                  {/* {entry.links.length > 0 && (
                    <div class="paper-links">
                      {entry.links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.label} ↗
                        </a>
                      ))}
                    </div>
                  )} */}
                </article>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</SiteLayout>

<style>
  .research-page,
  .research-page h1,
  .research-page h2,
  .research-page h3 {
    font-family: inherit;
  }

.research-intro {
  max-width: none;
  margin-bottom: 14px;
}

  .profile-links,
  .paper-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px;
  }

  .profile-links {
    font-size: 14px;
    line-height: 1.5;
  }

  .profile-links a,
  .paper-links a {
    color: #52634c;
    text-decoration: none;
  }

  .profile-links a:hover,
  .paper-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .profile-links span {
    color: #73776e;
  }

  .name-note {
    margin: 12px 0 0;
    color: #73776e;
    font-size: 12px;
    line-height: 1.5;
  }

  .research-page section {
    margin-top: 34px;
  }

  .research-page h2 {
    margin: 0 0 18px;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
  }

  .publication-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .publication {
    display: grid;
    grid-template-columns: 85px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
  }

  .publication + .publication {
    margin-top: 22px;
  }

  .publication-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 5px;
    color: #73776e;
    font-size: 14px;
    line-height: 1.5;
    text-align: right;
  }

  .publication article {
    min-width: 0;
  }

  .publication h3 {
    margin: 0 0 5px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.45;
  }

  .publication h3 a {
    color: #343730;
    text-decoration: underline;
    text-decoration-color: #b6bcae;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .publication h3 a:hover {
    color: #52634c;
    text-decoration-color: currentColor;
  }

  .publication p {
    max-width: none;
  }

  .authors {
    margin: 0 0 4px;
    font-size: 14px;
    line-height: 1.5;
  }

  .authors strong {
    font-weight: 700;
  }

  .venue,
  .publication-note {
    color: #73776e;
    font-size: 13px;
    line-height: 1.5;
  }

  .venue {
    margin: 0;
  }

  .publication-note {
    margin: 3px 0 0;
  }

  .paper-links {
    margin-top: 5px;
    font-size: 13px;
    line-height: 1.5;
  }

  .research-page a:focus-visible {
    outline: 2px solid #62735b;
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    .publication {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .publication-label {
      justify-content: flex-start;
      font-size: 12px;
      text-align: left;
    }

    .publication h3 {
      font-size: 16px;
    }

    .publication + .publication {
      margin-top: 24px;
    }
  }
</style>